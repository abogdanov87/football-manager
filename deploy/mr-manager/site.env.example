# Copy to ~/www/mr-manager.ru/site.env on the server (not committed).
# API: Passenger + passenger_wsgi.py only (Reg.ru forbids Gunicorn on ports >1024).

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=mr-manager.ru,www.mr-manager.ru
DJANGO_TIME_ZONE=Europe/Moscow

DB_ENGINE=mysql
DB_NAME=u3540963_default
DB_USER=u3540963_default
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOWED_ORIGINS=https://mr-manager.ru,https://www.mr-manager.ru

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=team@mr-manager.ru
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=team@mr-manager.ru

ALLOW_MANUAL_MATCHDAY_SIMULATION=false
HOSTING_LEGACY_MYSQL=1
