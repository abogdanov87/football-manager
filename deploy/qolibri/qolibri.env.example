# Copy to ~/www/qolibri.ru/qolibri.env on the server (not committed).

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=qolibri.ru,www.qolibri.ru
DJANGO_TIME_ZONE=Europe/Moscow

# SQLite by default on Reg.ru (MySQL 5.7 is too old for Django 6).
# For MySQL 8.4+: set DB_ENGINE=mysql and DB_* variables.

CORS_ALLOWED_ORIGINS=https://qolibri.ru,https://www.qolibri.ru

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.hosting.reg.ru
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@qolibri.ru

ALLOW_MANUAL_MATCHDAY_SIMULATION=false
